+#[test]
+fn test_find_throw_statements_skips_hash_comments() {
+    let body = r#"
+        # throw new HashCommentException();
+        throw new RealException("msg");
+    "#;
+    let throws = find_throw_statements(body);
+    assert_eq!(throws.len(), 1);
+    assert_eq!(throws[0].type_name, PhpType::named(atom("RealException")));
+}
+
+#[test]
+fn test_find_throw_statements_multibyte_hash_comment_no_panic() {
+    // Regression: `#` comments were not skipped and the speculative
+    // `&body[pos..pos + 5]` comparison panicked when `pos` walked into a
+    // multibyte character ("end byte index N is not a char boundary").
+    let body = "\t\t# Проверка входных данных: каталог\n\t\tthrow new LogicException('пусто');\n";
+    let throws = find_throw_statements(body);
+    assert_eq!(throws.len(), 1);
+    assert_eq!(throws[0].type_name, PhpType::named(atom("LogicException")));
+}
+
+#[test]
+fn test_find_throw_statements_multibyte_strings_and_comments() {
+    let body = "\t\t// Комментарий: бросаем исключение\n\t\t$msg = 'ошибка данных';\n\t\t/* примечание */\n\t\tthrow new DomainException($msg);\n";
+    let throws = find_throw_statements(body);
+    assert_eq!(throws.len(), 1);
+    assert_eq!(throws[0].type_name, PhpType::named(atom("DomainException")));
+}
+
+#[test]
+fn test_find_catch_blocks_multibyte_no_panic() {
+    let body = "\t\t# Комментарий с кириллицей\n\t\ttry {\n\t\t\tthrow new RuntimeException('ошибка');\n\t\t} catch (RuntimeException $e) {\n\t\t}\n";
+    let catches = find_catch_blocks(body);
+    assert_eq!(catches.len(), 1);
+}
+
+#[test]
+fn test_find_propagated_throws_multibyte_no_panic() {
+    let body = "\t\t# Комментарий: вызов метода\n\t\t$this->save('сохранение каталога');\n";
+    let file_content = "class S {\n\t/**\n\t * @throws RuntimeException\n\t */\n\tpublic function save(string $x): void {}\n}\n";
+    let propagated = find_propagated_throws(body, file_content);
+    assert_eq!(propagated.len(), 1);
+    assert_eq!(
+        propagated[0].type_name,
+        PhpType::named(atom("RuntimeException"))
+    );
+}
