 // ── Helpers ─────────────────────────────────────────────────────────
 
+/// Locate the php-cs-fixer config governing `file` by walking up from
+/// its directory, mirroring how the tool itself discovers a project
+/// root (`.php-cs-fixer.php`, then `.php-cs-fixer.dist.php`).
+fn find_php_cs_fixer_config(file: &Path) -> Option<PathBuf> {
+    let mut dir = file.parent()?;
+    loop {
+        for name in [".php-cs-fixer.php", ".php-cs-fixer.dist.php"] {
+            let candidate = dir.join(name);
+            if candidate.is_file() {
+                return Some(candidate);
+            }
+        }
+        dir = dir.parent()?;
+    }
+}
