{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": false,
    "baseUrl": ".",
    "paths": {
      /* Алиас как в реальных проектах; значения "…/*" содержат "/*" —
         регресс-охрана строково-чувствительного стриппера vue-css-jump */
      "@/*": ["./*"]
    }
  },
  "vueCompilerOptions": {
    "strictCssModules": true,
    "resolveStyleImports": true
  },
  "cmkOptions": {
    "enabled": true
  },
  "include": ["**/*"],
  "exclude": ["node_modules", ".vscode-test"]
}
