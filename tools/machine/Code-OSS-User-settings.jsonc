// Снимок user settings Code OSS — 2026-10-02
// Источник правды — живой файл: /home/povly/.config/Code - OSS/User/settings.json
// Обновлено скриптом tools/machine/export-user-settings.sh (не править руками)

{
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Kanagawa Wave",
  "workbench.iconTheme": "material-icon-theme",
  // Меню-бар — компакт-кнопка в титлбаре: при переключении раскладки Alt+Shift
  // (XKB grp:alt_shift_toggle) одиночный Alt-up активирует классический
  // меню-бар (панель File) и крадёт фокус ввода (нужен ESC). Без меню-бара
  // Alt нечего активировать. Гайд: docs/kde-lang-switch-focus-fix.md (_vscode)
  "window.menuBarVisibility": "compact",
  "[php]": {
    "editor.defaultFormatter": "junstyle.php-cs-fixer",
    // Форматирование при сохранении (2026-10-02, аудит /var/www): в воркспейсе
    // _vscode действует глобальный editor.formatOnSave, а в standalone-корнях
    // (13 Laravel + 17 WP) PHP не форматировался вовсе. Теперь табы ×2 через
    // машинный конфиг junstyle в ЛЮБОМ окне (автосейв afterDelay тоже запускает).
    "editor.formatOnSave": true,
  },
  // PHP-форматтер junstyle: машинный конфиг (табы ×2 + PSR12 + indentation_type).
  // "~/" поддерживается расширением → действует в любом открытом корне; воркспейс
  // _vscode перекрывает своим .vscode/.php-cs-fixer.php на workspace-уровне.
  // Анти-паттерн: laravel.vscode-laravel как [php]-форматтер (его Pint-поведение
  // зависит от наличия vendor/bin/pint в корне проекта).
  "php-cs-fixer.config": "~/.config/vscode-php-cs-fixer/.php-cs-fixer.php",
  // CLI-бинарь composer global (v3.95.26) — через wrapper: junstyle спавнит фиксер
  // с cwd каталога редактируемого файла, а php-cs-fixer ищет composer.json строго
  // в cwd (без walk-up) → WARN «Unable to determine minimum PHP version…» на каждом
  // сохранении. Wrapper ставит cwd = ~/.config/vscode-php-cs-fixer (там служебный
  // composer.json с config.platform.php). Шаблоны: tools/machine/ в воркспейсе _vscode.
  "php-cs-fixer.executablePath": "~/.config/vscode-php-cs-fixer/php-cs-fixer-wrapper.sh",
  "security.workspace.trust.untrustedFiles": "open",
  "chat.disableAIFeatures": true,
  "editor.minimap.enabled": false,
  "terminal.integrated.stickyScroll.enabled": false,
  // Sticky scroll редактора — on (паритет с воркспейсом): контекст-шапка
  // при навигации по большим файлам (WP/Bitrix/vendor).
  // Терминальный sticky scroll — off (осознанный выбор)
  "editor.stickyScroll.enabled": true,
  "workbench.editor.revealIfOpen": true,
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    // + форматирование при сохранении (2026-10-02, паритет с воркспейсом):
    // blade-шаблоны standalone-корней форматируются табами ×2 на Ctrl+S
    "editor.formatOnSave": true,
  },
  // Blade — табы ×2 глобально (как в воркспейсе _vscode; без этих ключей
  // blade-formatter по умолчанию делает 4 пробела)
  "bladeFormatter.format.useTabs": true,
  "bladeFormatter.format.indentSize": 2,
  "bladeFormatter.format.wrapAttributes": "auto",
  // Prettier: табы ×2 по умолчанию (в корнях без проектного .prettierrc);
  // JSON/YAML — исключение в [lang]-блоках ниже (2 пробела).
  // JS-форматирование полностью глобально (паттерн tools/machine в _vscode):
  // в ЛЮБОМ корне без проектных конфигов — табы ×2, формат на сохранении,
  // автофикс ESLint; JS-проекты не кладут .prettierrc/.vscode в репо
  "prettier.useTabs": true,
  "prettier.tabWidth": 2,
  "prettier.singleAttributePerLine": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  // Автофикс ESLint на сохранении (no-op в корнях без eslint-конфига)
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },

  // PHP: единственный LSP — PHPantom
  "php.validate.enable": false,
  // Бинарник НЕ закрепляем в serverPath: расширение само владеет жизненным
  // циклом (globalStorage/phpantom.phpantom/bin + autoUpdate). Политика:
  // LSP берём из расширения Code OSS; нет расширения — системный пакет.

  // Не индексировать тяжёлые директории
  "search.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/target": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/.vscode-test": true,
    // Ядра CMS — чужой код (глобально для окон вне воркспейса _vscode;
    // свой код Bitrix: local/**, WP: свои темы/плагины — остаются в поиске)
    "**/bitrix": true,
    "**/upload": true,
    "**/wp-admin": true,
    "**/wp-includes": true,
    // Скомпилированные blade-views/кэш Laravel — сгенерированный код (2026-10-02):
    // Ctrl+Shift+F в standalone-корнях не дублирует находки из storage
    // (watcher это уже исключал). storage/logs остаётся доступным поиску.
    "**/storage/framework": true,
  },
  "files.watcherExclude": {
    "**/vendor/**": true,
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/dist/**": true,
    "**/storage/framework/**": true,
    "**/storage/logs/**": true,
    "**/.vscode-test/**": true,
    "**/bitrix/**": true,
    "**/upload/**": true,
    "**/wp-admin/**": true,
    "**/wp-includes/**": true,
  },

  // Emmet в Vue-шаблонах
  "emmet.includeLanguages": {
    "vue": "html",
    "vue-html": "html",
    "blade": "html",
    "postcss": "css",
  },
  // Vue — Prettier (паритет с воркспейсом _vscode): форматтер Volar не читает
  // prettier.useTabs/tabWidth → в чужих окнах SFC форматировались пробелами
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "explorer.confirmDelete": false,
  "files.autoSave": "afterDelay",

  // Todo Tree: путь к системному ripgrep (в Arch-сборке code нет встроенного;
  // правильный ключ — с двойным "ripgrep", текст ошибки называет старый)
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  // Телеметрия — off на машинном уровне (паритет с воркспейсом _vscode);
  // redhat.* гасит телеметрию расширений Red Hat (vscode-xml и др.)
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  // Rust: форматтер — rust-analyzer (rustfmt через LSP), действует в любом проекте;
  // форматирование при сохранении — только для [rust], веб-проекты не затронуты
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
  },
  // Rust (глобально, любой проект): clippy-диагностики на сохранении вместо cargo check
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.allTargets": true,
  // Память RA (гайд docs/rust-memory.md в воркспейсе _vscode): кап кэшей запросов —
  // ниже steady-RSS (замер без cap'а: 2.6 GB на iced-проекте); трейдофф — пересчёты.
  // Плавный startup-прайминг: индексация воркспейса 2 потоками вместо всех ядер.
  "rust-analyzer.cachePriming.numThreads": 2,
  "rust-analyzer.lru.capacity": 128,
  // Run/Debug-лензы над функциями и тестами
  "rust-analyzer.lens.enable": true,
  "rust-analyzer.lens.debug.enable": true,
  "rust-analyzer.lens.run.enable": true,
  // Меньше шума: без подсказок закрывающей скобки у многострочных блоков
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  // Табы ×2 при форматировании в ЛЮБОМ проекте без rustfmt.toml (конвенция воркспейса);
  // CLI cargo fmt читает проектный rustfmt.toml (шаблон — rust-study)
  "rust-analyzer.rustfmt.extraArgs": [
    "--config",
    "hard_tabs=true",
    "--config",
    "tab_spaces=2",
  ],
  // Логи LSP: Output → Rust Analyzer (при проблемах переключать в "verbose")
  "rust-analyzer.trace.server": "messages",

  // WGSL — форматтер wgsl-analyzer (встроенный wgslfmt): стиль фиксирован
  // (4 пробела; клиентские опции сервер игнорирует — конфиг-ключей отступа
  // в схеме нет). Редактор выровнен под выход форматтера, иначе табы ↔
  // пробелы зациклятся с formatOnSave. Зеркала: .vscode воркспейса + .editorconfig
  "[wgsl]": {
    "editor.defaultFormatter": "wgsl-analyzer.wgsl-analyzer",
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
  },

  // ═══ IntelliSense CSS/Vue/Laravel — глобально (источник: воркспейс _vscode,
  //      гайд: docs/vue-css-intellisense.md в _vscode) ═══

  // Отступы: табы шириной 2, символы пробелов не отображаются (без точек)
  "editor.tabSize": 2,
  "editor.insertSpaces": false,
  "editor.detectIndentation": false,
  "editor.renderWhitespace": "none",

  // Подсказки в строках: классы, пути, значения атрибутов
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true,
  },

  // Подсказки: превью в списке, параметры вызовов, сниппеты первыми
  // (в топе через snippetSuggestions: top), форматирование при вставке
  // (глобально, любой корень). Tab разворачивает ТОЛЬКО сниппеты
  // (onlySnippets — паритет с воркспейсом _vscode): Enter принимает
  // подсказки, Tab в коде всегда даёт таб-отступ
  "editor.suggest.preview": true,
  "editor.parameterHints.enabled": true,
  "editor.snippetSuggestions": "top",
  "editor.tabCompletion": "onlySnippets",
  "editor.formatOnPaste": true,

  // ═══ Inlay hints JS/TS (2026-10-02; встроенный TS-сервис, Vue — через Volar) ═══
  // parameterNames «literals» — имена параметров только у литеральных аргументов
  // (минимум шума); enumMemberValues — значения enum; variableTypes — инференс
  // типов переменных (JS без аннотаций + TS), suppressWhenNoMatches гасит пустые.
  // Шумные режимы (parameterTypes на call-site, functionLikeReturnTypes) — off.
  // Порядок import-ов вторым сортировщиком (source.organizeImports) НЕ включаем:
  // им владеет ESLint `import/order` + source.fixAll.eslint на сохранении
  // (6 проектов /var/www) — два сортировщика конфликтовали бы на каждом Ctrl+S.
  "javascript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "javascript.inlayHints.enumMemberValues.enabled": true,
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "javascript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.variableTypes.enabled": true,
  "javascript.inlayHints.variableTypes.suppressWhenNoMatches": true,
  "typescript.inlayHints.variableTypes.suppressWhenNoMatches": true,

  // postcss-ловушка: язык «postcss» глушит CSS IntelliSense → .pcss/.postcss = scss
  "files.associations": {
    "*.blade.php": "blade",
    "*.pcss": "scss",
    "*.postcss": "scss",
    "*.wgsl": "wgsl",
    "*.volt": "html",
  },
  "scss.lint.unknownAtRules": "ignore",

  // CSS-переменные var(--…) по всему проекту (нужно расширение vunguyentuan.vscode-css-variables)
  "cssVariables.lookupFiles": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "**/*.vue",
  ],

  // Color picker: встроенный (клик по квадратику) + квадратики во ВСЕХ языках
  "editor.colorDecorators": true,
  "editor.defaultColorDecorators": "auto",

  // ═══ Global-first: editor-поведение воркспейса _vscode — на машинный уровень
  //      (чужие окна без .vscode получают те же фишки; 2026-09-29) ═══
  "emmet.triggerExpansionOnTab": true, // Emmet по Tab (в любом окне, не только в _vscode)
  "editor.linkedEditing": true, // синхронное переименование парных HTML-тегов (замена auto-rename-tag)
  "editor.mouseWheelZoom": true, // Ctrl+колесо — масштаб шрифта
  "editor.rulers": [120],
  "editor.guides.bracketPairs": "active", // направляющие пар скобок активного блока
  "editor.hover.delay": 150,
  "editor.wordBasedSuggestions": "currentDocument",
  "editor.acceptSuggestionOnEnter": "on",
  "explorer.compactFolders": false, // папки не схлопываются в одну строку пути
  "explorer.confirmDragAndDrop": false,
  "diffEditor.ignoreTrimWhitespace": false, // git-дифф показывает и пробельные изменения
  // Фикс (2026-10-02): комментарий декларировал «меньше обновлений», но "on"
  // качал и отключённые расширения. Паритет с воркспейсом: onlyEnabledExtensions.
  "extensions.autoUpdate": "onlyEnabledExtensions",
  "files.autoGuessEncoding": true, // старые файлы WP/Bitrix в cp1251 открываются корректно

  // JSON/YAML — единственное исключение из табов: 2 пробела
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "prettier.useTabs": false,
    "editor.formatOnSave": true,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "prettier.useTabs": false,
    "editor.formatOnSave": true,
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "prettier.useTabs": false,
    "editor.formatOnSave": true,
  },
  "security.promptForLocalFileProtocolHandling": false,
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  // TOML (2026-10-02): even-better-toml — как в воркспейсе _vscode. Cargo.toml /
  // phpantom.toml / rust-toolchain.toml в любом корне: 2 пробела + формат на
  // сохранении (TOML — исключение из табов, как JSON/YAML)
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
  },

  // ═══ Глобальные фишки (2026-09-23, источник: воркспейс _vscode) ═══

  // Чужой код — read-only: случайная правка vendor/ядер CMS невозможна
  // (чтение/F12 доступны; снять — «Files: Toggle Active File Read Only in Session»)
  "files.readonlyInclude": {
    "**/vendor/**": true,
    "**/node_modules/**": true,
    "**/bitrix/**": true,
    "**/wp-admin/**": true,
    "**/wp-includes/**": true,
    "**/target/**": true,
    "**/dist/**": true,
  },

  // File nesting: lock/конфиг-файлы сворачиваются под основной манифест
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, bun.lockb, pnpm-lock.yaml, yarn.lock, .prettierrc*, .eslintrc*",
    "Cargo.toml": "Cargo.lock, rustfmt.toml, rust-toolchain.toml",
    "composer.json": "composer.lock, .php-cs-fixer.php, pint.json",
  },

  // Перенос/переименование файлов: import-пути обновляются сами
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",

  // ═══ Встроенные возможности Code OSS 2025–2026 (без расширений; 2026-09-29) ═══

  // Git blame в строке редактора — встроено с 1.97 (free-замена GitLens-функции);
  // статус-бар item — on по умолчанию. Авто-fetch — фоном, безопасно
  "git.blame.editorDecoration.enabled": true,
  "git.autofetch": true,
  // Без диалога подтверждения на Sync (философия «без лишних подтверждений» —
  // confirmDelete/confirmDragAndDrop уже off; авто-fetch включён)
  "git.confirmSync": false,

  // Terminal IntelliSense — GA с 1.106: completions путей/флагов/истории в bash
  "terminal.integrated.suggest.enabled": true,

  // Alt+R/A/M/L (phpantom — биндинги в машинном keybindings.json) работают и из
  // терминала: команды перехватываются Code, а не уходят в shell. Дефолтный
  // список commandsToSkipShell сохраняется (убрать дефолт — префикс '-commandId');
  // при добавлении новых phpantom-команд — синхронизировать (зеркало воркспейса)
  "terminal.integrated.commandsToSkipShell": [
    "phpantom.showRouteList",
    "phpantom.runArtisanCommand",
    "phpantom.generateModelAnnotations",
    "phpantom.showLogViewer",
  ],

  // Дебаг: брейкпоинты деревом по файлам (1.108) — удобно при Xdebug/CodeLLDB
  "debug.breakpointsView.presentation": "tree",

  // ═══ Файловая гигиена (глобально, любой корень) ═══
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,

  // ═══ Минимализм + компактность «Zed-вайб» (2026-09-30) ═══
  // Activity bar, вкладки, статус-бар, sticky scroll — НЕ тронуты (привычка).
  // Лишнее: command center (дубль Ctrl+P), breadcrumbs (путь над файлом),
  // тулбар группы редактора (split/«…» — кнопки появляются при hover на вкладку),
  // стрелки фолдинга (фолдинг остаётся: Ctrl+Shift+[ / ]), tips-тосты.
  "window.commandCenter": false,
  "workbench.breadcrumbs.enabled": false,
  "workbench.editor.actionBar.location": "hidden",
  "workbench.tips.enabled": false,
  "editor.showFoldingControls": "always",
  // Компактность: плотные списки/дерева, вкладки ниже, тонкие скроллбары.
  // Масштаб UI — стандартный (zoom 0: хром на 100%); код мельче дефолта
  // (fontSize 13), терминал чуть крупнее кода (14). Откат — одна строка.
  "workbench.list.tightTree": true,
  "workbench.editor.tabHeight": "compact",
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.scrollbar.horizontalScrollbarSize": 8,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "window.zoomLevel": 0,
  "editor.fontSize": 13,
  "terminal.integrated.fontSize": 14,
  // Плавность (Zed-feel)
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
}
