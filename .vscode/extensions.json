  // "donjayamanne.githistory",         // Git History: история файла/сравнение веток (основной сценарий уже покрыт git-graph)
  // "yzhang.markdown-all-in-one",      // Markdown All in One: TOC и шорткаты (markdownlint уже в базе)

  // НЕ рекомендуем (freemium / платные функции / конфликты):
