{
  // Конфигурации отладки (F5) — всё бесплатное
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PHP: слушать Xdebug (Laravel / WordPress / Bitrix)",
      "type": "php",
      "request": "launch",
      "port": 9003,
      // Сервер должен быть запущен с Xdebug (см. README), например:
      //   php artisan serve          (Laravel)
      //   php -S localhost:8000      (WordPress/Bitrix)
      "pathMappings": {}
    },
    {
      // Стек Vite-only: сурсмапы js-debug резолвит по webRoot самостоятельно
      // (легаси-оверрайды webpack:// удалены 2026-09-23)
      "name": "JS: сайт через Vite dev-server (localhost:5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      // Постоянный профиль: логины сохраняются между сессиями дебага
      // (по умолчанию js-debug создаёт временный — авторизация заново).
      // Каталог исключён из git через .gitignore (куки/сессии не коммитим).
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"
    },
    {
      "name": "JS: сайт через artisan serve (localhost:8000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}",
      // Постоянный профиль — тот же, что у Vite-конфигурации (см. комментарий выше)
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"
    },
    {
      // kind-only фильтр: CodeLLDB запускает единственный bin-таргет проекта
      // без указания имени (Run/Debug-лензы rust-analyzer — альтернатива).
      // Если в Cargo.toml НЕСКОЛЬКО [[bin]] — вернуть "name": "<имя-бинаря>"
      "name": "Rust: отладка бинарника (cargo build, CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build"],
        "filter": {
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      // Одна F5 — оба дебаггера сразу: PHP (Xdebug) + JS (Chrome).
      // ВАЖНО: сервер (php artisan serve / npm run dev) должен быть уже
      // запущен — compound подключается к процессам, но не стартует их.
      "name": "Fullstack: Xdebug + Chrome (Vite)",
      "configurations": [
        "PHP: слушать Xdebug (Laravel / WordPress / Bitrix)",
        "JS: сайт через Vite dev-server (localhost:5173)"
      ]
    },
    {
      "name": "Fullstack: Xdebug + Chrome (artisan)",
      "configurations": [
        "PHP: слушать Xdebug (Laravel / WordPress / Bitrix)",
        "JS: сайт через artisan serve (localhost:8000)"
      ]
    }
  ]
}
