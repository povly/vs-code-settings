# EditorConfig — источник правды для отступов (работает и вне VS Code)
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2 # ширина таба = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# JSON/YAML — пробелы (сырые табы в строках JSON запрещены)
[{*.json,*.jsonc,*.yml,*.yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
